<idea-plugin>
  <id>dev.wavelang.wave</id>
  <name>Wave Language</name>
  <version>0.3.0</version>
  <vendor url="https://github.com/wavefnd">Wave Foundation</vendor>
  <description>Support for Wave source files and compiler development files.</description>
  <resource-bundle>messages.WaveBundle</resource-bundle>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.lang</depends>
  <depends>com.intellij.modules.lsp</depends>

  <extensions defaultExtensionNs="com.intellij">
    <projectConfigurable groupId="language" id="wfp.toolchains"
                         bundle="messages.WaveBundle" key="toolchains.title"
                         instance="dev.wavelang.intellij.wave.toolchain.ToolchainConfigurable"/>
    <fileType name="Wave" language="Wave" implementationClass="dev.wavelang.intellij.wave.WaveFileType" extensions="wave"/>
    <fileType name="Wave Makefile" language="WaveMakefile" implementationClass="dev.wavelang.intellij.wave.make.MakefileFileType"
              extensions="mk;mak" fileNames="Makefile;GNUmakefile"/>
    <fileType name="Wave Assembly" language="WaveAssembly" implementationClass="dev.wavelang.intellij.wave.asm.AssemblyFileType"
              extensions="s;S;asm;nasm;riscv;rvs"/>
    <fileType name="Wave Linker Script" language="WaveLinkerScript" implementationClass="dev.wavelang.intellij.wave.ld.LinkerScriptFileType"
              extensions="ld"/>
    <fileType name="Whale IR" language="WhaleIR" implementationClass="dev.wavelang.intellij.wave.ir.WhaleIrFileType"
              extensions="wir"/>
    <lang.syntaxHighlighterFactory language="Wave" implementationClass="dev.wavelang.intellij.wave.highlight.WaveSyntaxHighlighterFactory"/>
    <lang.syntaxHighlighterFactory language="WaveMakefile" implementationClass="dev.wavelang.intellij.wave.make.MakefileSyntaxHighlighterFactory"/>
    <lang.syntaxHighlighterFactory language="WaveAssembly" implementationClass="dev.wavelang.intellij.wave.asm.AssemblySyntaxHighlighterFactory"/>
    <lang.syntaxHighlighterFactory language="WaveLinkerScript" implementationClass="dev.wavelang.intellij.wave.ld.LinkerScriptSyntaxHighlighterFactory"/>
    <lang.syntaxHighlighterFactory language="WhaleIR" implementationClass="dev.wavelang.intellij.wave.ir.WhaleIrSyntaxHighlighterFactory"/>
    <platform.lsp.serverSupportProvider implementation="dev.wavelang.intellij.wave.lsp.WaveLspServerSupportProvider"/>
    <platform.lsp.integrationProvider implementation="dev.wavelang.intellij.wave.rust.RustLspIntegrationProvider"/>
    <configurationType implementation="dev.wavelang.intellij.wave.cargo.CargoConfigurationType"/>
    <directoryIndexExcludePolicy implementation="dev.wavelang.intellij.wave.cargo.CargoExcludePolicy"/>
    <notificationGroup id="WfP Rust" displayType="BALLOON" bundle="messages.WaveBundle" key="rust.notification.group"/>
  </extensions>
  <actions>
    <action id="Wfp.Cargo.Refresh" class="dev.wavelang.intellij.wave.cargo.CargoRefreshAction">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="Wfp.Cargo.Targets" class="dev.wavelang.intellij.wave.cargo.CargoTargetsAction">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="Wfp.Rust.Format" class="dev.wavelang.intellij.wave.rust.RustFormatAction">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
